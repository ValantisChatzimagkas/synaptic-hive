# Local development (running the API on the host against dockerized services).
# `docker compose up --build` does not read DATABASE_URL/REDIS_URL; it builds
# them from the variables below.
DATABASE_URL=postgresql://iot_user:iot_password@localhost:5432/iot_db
REDIS_URL=redis://localhost:6379/0

# Measurement ingestion mode: "async" (Redis Stream) or "sync" (direct DB write)
INGESTION_MODE=async

# Docker Compose overrides (all optional, defaults shown)
# POSTGRES_USER=iot_user
# POSTGRES_PASSWORD=iot_password
# POSTGRES_DB=iot_db
# DB_PORT=5432
# API_PORT=8000
# REDIS_PORT=6379
